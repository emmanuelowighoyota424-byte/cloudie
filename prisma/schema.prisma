generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}
enum WorkspaceRole {
  SUPER_ADMIN
  WORKSPACE_ADMIN
  MANAGER
  STAFF
  DRIVER
  WAREHOUSE_STAFF
  CUSTOMER
  VENDOR
}
enum WorkspaceMemberStatus {
  ACTIVE
  SUSPENDED
}
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}
enum ShipmentStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  RETURNED
}
enum Plan {
  FREE
  STARTER
  BUSINESS
  ENTERPRISE
}
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  role UserRole @default(USER)
  suspendedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pointLedger PointLedger[]
  shipmentsCreated Shipment[] @relation("ShipmentCreator")
  notifications Notification[]
  referrals Referral[]
  auditLogs AuditLog[] @relation("AuditUser")
  auditActorLogs AuditLog[] @relation("AuditActor")
  kycVerifications KYCVerification[]
  workspaceMembers WorkspaceMember[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  invitationsSent WorkspaceInvitation[] @relation("InvitationInviter")
  invitationsAccepted WorkspaceInvitation[] @relation("InvitationAcceptor")
  documents Document[] @relation("DocumentOwner")
  documentShares DocumentShare[]
  documentAccesses DocumentAccess[]
  drivers Driver[]
  orders Order[] @relation("CustomerOrders")
  sessions Session[]
  accounts Account[]
  warehouseAssignments WarehouseStaffAssignment[]
}

model PointLedger {
  id String @id @default(cuid())
  userId String
  amount Int
  balance Int
  description String
  reference String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
}

model Workspace {
  id String @id @default(cuid())
  name String
  slug String @unique
  ownerId String
  plan Plan @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation("WorkspaceOwner",fields:[ownerId],references:[id],onDelete:Restrict)
  members WorkspaceMember[]
  invitations WorkspaceInvitation[]
  shipments Shipment[]
  customers Customer[]
  vendors Vendor[]
  warehouses Warehouse[]
  drivers Driver[]
  documents Document[]
  products Product[]
  orders Order[]
  notifications Notification[]
  auditLogs AuditLog[]
  subscription Subscription?
  warehouseAssignments WarehouseStaffAssignment[]
  @@index([ownerId])
}

model WorkspaceMember {
  id String @id @default(cuid())
  workspaceId String
  userId String
  role WorkspaceRole
  status WorkspaceMemberStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([workspaceId,userId])
  @@index([userId,status])
  @@index([workspaceId,role])
}

model WorkspaceInvitation {
  id String @id @default(cuid())
  workspaceId String
  email String
  role WorkspaceRole
  tokenHash String @unique
  status InvitationStatus @default(PENDING)
  expiresAt DateTime
  invitedById String
  acceptedById String?
  createdAt DateTime @default(now())
  acceptedAt DateTime?
  revokedAt DateTime?
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  invitedBy User @relation("InvitationInviter",fields:[invitedById],references:[id],onDelete:Restrict)
  acceptedBy User? @relation("InvitationAcceptor",fields:[acceptedById],references:[id],onDelete:SetNull)
  @@index([email,status])
  @@index([workspaceId,createdAt])
}

model Shipment {
  id String @id @default(cuid())
  workspaceId String
  trackingId String @unique
  creatorId String
  customerId String?
  driverId String?
  warehouseId String?
  origin String
  destination String
  status ShipmentStatus @default(PENDING)
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  creator User @relation("ShipmentCreator",fields:[creatorId],references:[id],onDelete:Restrict)
  customer Customer? @relation(fields:[customerId],references:[id],onDelete:SetNull)
  driver Driver? @relation(fields:[driverId],references:[id],onDelete:SetNull)
  warehouse Warehouse? @relation(fields:[warehouseId],references:[id],onDelete:SetNull)
  events ShipmentEvent[]
  proofOfDelivery ProofOfDelivery?
  documents Document[] @relation("ShipmentDocuments")
  @@index([workspaceId,status])
  @@index([workspaceId,createdAt])
  @@index([customerId])
  @@index([driverId])
}

model ShipmentEvent {
  id String @id @default(cuid())
  shipmentId String
  status ShipmentStatus
  location String?
  note String?
  createdAt DateTime @default(now())
  shipment Shipment @relation(fields:[shipmentId],references:[id],onDelete:Cascade)
  @@index([shipmentId,createdAt])
}

model Customer {
  id String @id @default(cuid())
  workspaceId String
  name String
  email String?
  phone String?
  address String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  shipments Shipment[]
  orders Order[]
  documents Document[] @relation("CustomerDocuments")
  @@index([workspaceId,email])
}

model Driver {
  id String @id @default(cuid())
  workspaceId String
  userId String?
  name String
  phone String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  shipments Shipment[]
  @@index([workspaceId,status])
  @@index([userId])
}

model Warehouse {
  id String @id @default(cuid())
  workspaceId String
  name String
  address String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  shipments Shipment[]
  staffAssignments WarehouseStaffAssignment[]
  @@index([workspaceId,status])
}

model WarehouseStaffAssignment {
  id String @id @default(cuid())
  workspaceId String
  warehouseId String
  userId String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  warehouse Warehouse @relation(fields:[warehouseId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([warehouseId,userId])
  @@index([workspaceId,userId])
  @@index([userId])
}

model ProofOfDelivery {
  id String @id @default(cuid())
  shipmentId String @unique
  recipient String
  signatureUrl String?
  photoUrl String?
  notes String?
  deliveredAt DateTime @default(now())
  shipment Shipment @relation(fields:[shipmentId],references:[id],onDelete:Cascade)
}

model Document {
  id String @id @default(cuid())
  workspaceId String
  ownerId String
  shipmentId String?
  customerId String?
  name String
  mimeType String
  sizeBytes BigInt
  storageKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  owner User @relation("DocumentOwner",fields:[ownerId],references:[id],onDelete:Restrict)
  shipment Shipment? @relation("ShipmentDocuments",fields:[shipmentId],references:[id],onDelete:Cascade)
  customer Customer? @relation("CustomerDocuments",fields:[customerId],references:[id],onDelete:SetNull)
  versions DocumentVersion[]
  shares DocumentShare[]
  accesses DocumentAccess[]
  @@index([workspaceId,createdAt])
  @@index([ownerId])
  @@index([shipmentId])
  @@index([customerId])
}

model DocumentVersion {
  id String @id @default(cuid())
  documentId String
  version Int
  storageKey String
  sizeBytes BigInt
  checksum String?
  createdAt DateTime @default(now())
  document Document @relation(fields:[documentId],references:[id],onDelete:Cascade)
  @@unique([documentId,version])
}

model DocumentShare {
  id String @id @default(cuid())
  documentId String
  userId String
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  document Document @relation(fields:[documentId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([documentId,userId])
  @@index([userId])
}

model DocumentAccess {
  id String @id @default(cuid())
  documentId String
  userId String?
  action String
  createdAt DateTime @default(now())
  document Document @relation(fields:[documentId],references:[id],onDelete:Cascade)
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  @@index([documentId,createdAt])
}

model Vendor {
  id String @id @default(cuid())
  workspaceId String
  name String
  category String
  status String @default("AVAILABLE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  products Product[]
  @@index([workspaceId,status])
}

model Product {
  id String @id @default(cuid())
  workspaceId String
  vendorId String?
  name String
  sku String
  description String?
  price Decimal @db.Decimal(12,2)
  stock Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  vendor Vendor? @relation(fields:[vendorId],references:[id],onDelete:SetNull)
  orderItems OrderItem[]
  @@unique([workspaceId,sku])
  @@index([workspaceId,active])
}

model Order {
  id String @id @default(cuid())
  workspaceId String
  customerId String?
  userId String?
  idempotencyKey String? @unique
  status String @default("PENDING")
  paymentStatus String @default("PENDING")
  subtotal Decimal @db.Decimal(12,2)
  commission Decimal @db.Decimal(12,2) @default(0)
  total Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  customer Customer? @relation(fields:[customerId],references:[id],onDelete:SetNull)
  user User? @relation("CustomerOrders",fields:[userId],references:[id],onDelete:SetNull)
  items OrderItem[]
  payments Payment[]
  @@index([workspaceId,createdAt])
  @@index([workspaceId,status])
  @@index([customerId])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Restrict)
  @@index([orderId])
  @@index([productId])
}

model Payment {
  id String @id @default(cuid())
  orderId String
  provider String
  providerReference String?
  status String @default("PENDING")
  amount Decimal @db.Decimal(12,2)
  currency String
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
  @@unique([provider,providerReference])
  @@index([orderId,status])
}

model WebhookEvent {
  id String @id @default(cuid())
  provider String
  eventId String
  payload Json
  receivedAt DateTime @default(now())
  processedAt DateTime?
  @@unique([provider,eventId])
}

model Subscription {
  id String @id @default(cuid())
  workspaceId String @unique
  plan Plan
  status SubscriptionStatus
  provider String?
  providerSubscriptionId String?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
}

model Notification {
  id String @id @default(cuid())
  userId String
  workspaceId String?
  title String
  message String
  type String @default("INFO")
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  workspace Workspace? @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
  @@index([workspaceId,createdAt])
}

model Referral {
  id String @id @default(cuid())
  userId String
  referredEmail String
  reward Int @default(0)
  status String @default("PENDING")
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  actorId String?
  workspaceId String?
  action String
  entity String
  entityId String?
  result String @default("SUCCESS")
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation("AuditUser",fields:[userId],references:[id],onDelete:SetNull)
  actor User? @relation("AuditActor",fields:[actorId],references:[id],onDelete:SetNull)
  workspace Workspace? @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
  @@index([actorId,createdAt])
  @@index([workspaceId,createdAt])
  @@index([entity,entityId])
}

model KYCVerification {
  id String @id @default(cuid())
  userId String
  status String @default("PENDING")
  provider String?
  reference String?
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,status])
}

model Account {
  id String @id
  accountId String
  providerId String
  userId String
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([providerId,accountId])
  @@index([userId])
}

model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
}

model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}

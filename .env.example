SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Durable PostgreSQL-backed job runner / Vercel Cron authentication
JOBS_RUNNER_SECRET=
CRON_SECRET=

# Private document/image storage behind Cloudie storage abstraction (Vercel Blob infrastructure)
BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_API_URL=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Paystack TEST/LIVE provider — the only intentional third-party business integration
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_CURRENCY=NGN

# Crypto infrastructure (configured blockchain node/RPC; no SaaS provider)
